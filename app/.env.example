# ROULÉ — variables d'environnement
# Copier en .env.local et renseigner les valeurs. Ne jamais committer .env.local.

# ── Supabase ──────────────────────────────────────────────────────────
# Dashboard Supabase > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role : contourne les RLS. Serveur uniquement (webhook Stripe).
# À NE JAMAIS préfixer NEXT_PUBLIC_ ni exposer côté navigateur.
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe ────────────────────────────────────────────────────────────
# Dashboard Stripe > Developers > API keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...

# En local : `stripe listen --forward-to localhost:3000/api/stripe/webhook`
# En production : Dashboard > Developers > Webhooks > signing secret
STRIPE_WEBHOOK_SECRET=whsec_...
